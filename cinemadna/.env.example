# CinemaDNA / DramaOS-X 环境变量模板
# ---------------------------------------------------------------------------
# 用法：把本文件复制为 .env，填入真实密钥。.env 已被 .gitignore 忽略，
#       绝不要提交真实密钥。留空的变量表示"该能力未接入"，代码会据此降级
#       （例如没有视频模型密钥就只能用本地 mock / placeholder 后端）。
#
# 变量的唯一权威定义在 config.py，新增变量请先在那里登记。
# ---------------------------------------------------------------------------

# --- LLM（剧本 / 表演 / QA 等文本智能，Phase 2+ 接入）---------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- 视频生成（Render Brain 真实后端，Phase 4+ 接入）----------------------
KLING_API_KEY=
# KLING 第三方网关地址（留空=不探测；官方快手 Kling 用 AK/SK，这里填聚合商，
# 例如 aimlapi.com：https://api.aimlapi.com）
KLING_API_BASE=
SEEDANCE_API_KEY=
RUNWAY_API_KEY=
# Runway 官方 SDK 用的密钥名（Act-Two character_performance；表演驱动 E1）
RUNWAYML_API_SECRET=

# --- 图像（场景 / 道具 / 参考图）-----------------------------------------
FAL_KEY=
TOGETHER_API_KEY=
# 强烈建议在此处填写 OPENAI_API_KEY 供 DALL-E 3 调用生成场景和人脸

# --- 音频（配音 / 唇同步，AudioDNA 接入）---------------------------------
ELEVENLABS_API_KEY=
# 强烈建议填写 ELEVENLABS_API_KEY 供真实 TTS 发音合成

# --- 运行环境 ------------------------------------------------------------
# development | staging | production
CINEMA_DNA_ENV=development
# Web 控制台监听地址（scripts/run_webui.py 会读取；命令行 --host/--port 优先）
WEB_HOST=127.0.0.1
WEB_PORT=8700
